---
/**
 * The only place canonical URLs, OG/Twitter meta, rel="me" links, and JSON-LD
 * are emitted. Every page routes its head through here so no page can diverge
 * from src/data/entity.ts (FR-1, US-005).
 */
import { ERIK } from '../data/entity';
import PersonSchema from './PersonSchema.astro';

interface Props {
  title: string;
  description: string;
  /** Site-root-relative path, e.g. '/' or '/about'. */
  path: string;
  schemaMode?: 'home' | 'profile' | 'page';
}

const { title, description, path, schemaMode = 'page' } = Astro.props;

const canonical = new URL(path, ERIK.canonicalUrl).href;
---
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />

<title>{title}</title>
<meta name="description" content={description} />
<meta name="author" content={ERIK.name} />
<meta name="robots" content="index, follow, max-image-preview:large" />
<meta name="theme-color" content="#f9f8f6" />
<link rel="canonical" href={canonical} />
{ERIK.googleSiteVerification && (
  <meta name="google-site-verification" content={ERIK.googleSiteVerification} />
)}

<!-- Open Graph -->
<meta property="og:type" content="profile" />
<meta property="og:url" content={canonical} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ERIK.ogImageUrl} />
<meta property="og:image:width" content={String(ERIK.ogImageWidth)} />
<meta property="og:image:height" content={String(ERIK.ogImageHeight)} />
<meta property="og:image:alt" content={ERIK.imageCaption} />
<meta property="og:locale" content="en_US" />
<meta property="og:site_name" content={ERIK.name} />
<meta property="profile:first_name" content={ERIK.givenName} />
<meta property="profile:last_name" content={ERIK.familyName} />
<meta property="profile:username" content={ERIK.twitterHandle.replace('@', '')} />

<!-- Twitter / X -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content={ERIK.twitterHandle} />
<meta name="twitter:creator" content={ERIK.twitterHandle} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ERIK.ogImageUrl} />
<meta name="twitter:image:alt" content={ERIK.imageCaption} />

<!-- Identity consolidation: same profile cluster as JSON-LD sameAs -->
{ERIK.profiles.map((profile) => <link rel="me" href={profile.url} />)}

<!-- Favicon -->
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="any" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />

<PersonSchema mode={schemaMode} url={canonical} title={title} description={description} />

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Inter:wght@300;400&display=swap"
  rel="stylesheet"
/>
