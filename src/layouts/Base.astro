---
import SEOHead from '../components/SEOHead.astro';
import { ERIK } from '../data/entity';

interface Props {
  title: string;
  description: string;
  path: string;
  schemaMode?: 'home' | 'profile' | 'page';
}

const { title, description, path, schemaMode } = Astro.props;

const nav = [
  { label: 'Home', href: '/' },
  { label: 'About', href: '/about' },
  { label: 'Press kit', href: '/press' },
];
const year = 2026;
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <SEOHead title={title} description={description} path={path} schemaMode={schemaMode} />
  </head>
  <body>
    <main>
      <slot />
    </main>

    <footer>
      <nav class="footer-nav" aria-label="Site">
        {nav.map((item) => (
          <a href={item.href} aria-current={item.href === path ? 'page' : undefined}>{item.label}</a>
        ))}
      </nav>
      <p>&copy; {year} {ERIK.name}</p>
    </footer>

    <style is:global>
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

      :root {
        --bg: #f9f8f6;
        --ink: #111;
        --mid: #888;
        --line: #e0ddd8;
      }

      body {
        background: var(--bg);
        color: var(--ink);
        font-family: 'Inter', sans-serif;
        font-weight: 300;
        font-size: 15px;
        line-height: 1.7;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
      }

      main {
        flex: 1;
        max-width: 600px;
        margin: 0 auto;
        padding: 80px 32px 80px;
        width: 100%;
      }

      a { color: inherit; }

      /* ── Hero block ── */
      .hero { margin-bottom: 56px; }

      .headshot {
        width: 96px;
        height: 96px;
        border-radius: 50%;
        object-fit: cover;
        display: block;
        margin-bottom: 20px;
        background: #efece7;
      }

      .name {
        font-family: 'Instrument Serif', serif;
        font-size: clamp(36px, 6vw, 52px);
        font-weight: 400;
        letter-spacing: -0.02em;
        line-height: 1.1;
        margin-bottom: 8px;
      }

      .tagline {
        font-family: 'Instrument Serif', serif;
        font-style: italic;
        font-size: 15px;
        color: var(--mid);
        margin-bottom: 10px;
      }

      .lede { font-size: 15px; line-height: 1.8; color: #333; margin-bottom: 18px; }

      .location {
        display: flex;
        align-items: center;
        gap: 4px;
        font-size: 13px;
        color: var(--mid);
        margin-bottom: 24px;
        font-style: normal;
      }

      .location svg { flex-shrink: 0; }

      /* ── Profile links ── */
      .links { display: flex; flex-wrap: wrap; gap: 6px; }

      .links a {
        font-size: 13px;
        color: var(--mid);
        text-decoration: none;
        border: 1px solid var(--line);
        padding: 5px 14px;
        border-radius: 100px;
        transition: color 0.15s, border-color 0.15s;
      }

      .links a:hover { color: var(--ink); border-color: #aaa; }

      /* ── Sections ── */
      hr { border: none; border-top: 1px solid var(--line); margin: 40px 0; }

      .section-label {
        font-size: 11px;
        font-weight: 400;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--mid);
        margin-bottom: 16px;
      }

      .sub-label {
        font-size: 11px;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--mid);
        margin: 28px 0 12px;
        font-weight: 400;
      }

      .sub-label:first-of-type { margin-top: 0; }

      /* Prose */
      .prose { font-size: 15px; line-height: 1.8; color: #333; }
      .prose p + p { margin-top: 14px; }
      .prose a {
        color: inherit;
        text-decoration: none;
        border-bottom: 1px solid var(--line);
        transition: border-color 0.15s;
      }
      .prose a:hover { border-color: var(--ink); }

      /* At a glance */
      .glance { display: grid; grid-template-columns: 128px 1fr; }

      .glance dt {
        font-size: 13px;
        color: var(--mid);
        padding: 11px 20px 11px 0;
        border-top: 1px solid var(--line);
      }

      .glance dd {
        font-size: 15px;
        padding: 11px 0;
        border-top: 1px solid var(--line);
      }

      /* Sections are separated by <hr>; a list's own trailing rule would
         double up with it. */
      .rows li:last-child,
      .timeline li:last-child,
      .principles li:last-child { border-bottom: none; }

      /* Rows (ventures, press, profiles) */
      .rows { list-style: none; }

      .rows li {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 16px;
        padding: 13px 0;
        border-bottom: 1px solid var(--line);
      }

      .rows li:first-child { border-top: 1px solid var(--line); }

      .row-name { font-size: 15px; font-weight: 400; }
      .row-note { font-size: 13px; color: var(--mid); flex-shrink: 0; text-align: right; }

      .rows a { text-decoration: none; color: inherit; }
      .rows a:hover .row-name { text-decoration: underline; text-underline-offset: 3px; }

      /* Timeline */
      .timeline { list-style: none; }

      .timeline li { padding: 16px 0; border-bottom: 1px solid var(--line); }
      .timeline li:first-child { border-top: 1px solid var(--line); }

      .timeline-years { font-size: 12px; color: var(--mid); letter-spacing: 0.04em; }

      .timeline-org {
        font-family: 'Instrument Serif', serif;
        font-size: 18px;
        letter-spacing: -0.01em;
        display: block;
        margin-top: 2px;
      }

      .timeline-role { font-size: 13px; color: var(--mid); }
      .timeline-desc { font-size: 14px; color: #333; margin-top: 6px; line-height: 1.7; }

      /* Principles */
      .principles { list-style: none; }
      .principles li { padding: 14px 0; border-bottom: 1px solid var(--line); }
      .principles li:first-child { border-top: 1px solid var(--line); }

      .principle-title {
        font-family: 'Instrument Serif', serif;
        font-size: 18px;
        font-weight: 400;
        letter-spacing: -0.01em;
      }

      /* Press kit */
      .kit { border: 1px solid var(--line); padding: 18px; margin-bottom: 16px; background: #fff; }
      .kit p { font-size: 14px; line-height: 1.75; color: #333; }
      .kit p + p { margin-top: 12px; }

      .kit-head {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 10px;
      }

      .kit-title {
        font-size: 11px;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--mid);
      }

      .copy-btn {
        font: inherit;
        font-size: 12px;
        color: var(--mid);
        background: none;
        border: 1px solid var(--line);
        border-radius: 100px;
        padding: 3px 12px;
        cursor: pointer;
        flex-shrink: 0;
      }

      .copy-btn:hover { color: var(--ink); border-color: #aaa; }

      .headshot--asset { width: 160px; height: 160px; border-radius: 2px; }

      .note { font-size: 13px; color: var(--mid); margin-top: 14px; }

      /* Footer */
      footer {
        text-align: center;
        padding: 24px 32px;
        font-size: 12px;
        color: #aaa;
      }

      .footer-nav { display: flex; gap: 16px; justify-content: center; margin-bottom: 8px; }
      .footer-nav a { color: var(--mid); text-decoration: none; }
      .footer-nav a:hover { color: var(--ink); }
      .footer-nav a[aria-current='page'] { color: var(--ink); }

      @media (max-width: 480px) {
        main { padding: 56px 24px 56px; }
        .glance { grid-template-columns: 1fr; }
        .glance dt { padding: 11px 0 0; border-top: 1px solid var(--line); }
        .glance dd { padding: 2px 0 11px; border-top: none; }
      }
    </style>
  </body>
</html>
